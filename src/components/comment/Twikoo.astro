<div id="tcomment"></div>
<script is:inline define:vars={{ config }}>
  function loadTwikoo() {
    const script = document.createElement("script");
    script.src = "https://registry.npmmirror.com/twikoo/1.7.11/files/dist/twikoo.min.js";
    script.defer = true;
    script.onload = () => {
      twikoo.init(config);
    };
    document.body.appendChild(script);
  }
  
  // 页面切换时执行
  document.addEventListener("loadComment", loadTwikoo, { once: true });
</script>